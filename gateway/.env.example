# API Gateway Environment Configuration
# Copy this file to .env and fill in actual values

# Gateway port
PORT=4000

# Allowed origin for CORS (frontend URL)
CLIENT_URL=http://localhost:5173

# Internal service URLs
# These are NEVER sent to the browser
USER_SERVICE_URL=http://localhost:5001
EMAIL_SERVICE_URL=http://localhost:5002
NEWS_GAME_SERVICE_URL=http://localhost:5003
CHAT_SERVICE_URL=http://localhost:5004

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

# Environment
NODE_ENV=development
